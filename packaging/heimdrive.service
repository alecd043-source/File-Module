[Unit]
Description=HeimDrive - Dateien im lokalen Netzwerk
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=heimdrive
Group=heimdrive
EnvironmentFile=/etc/heimdrive.env
Environment=GOGC=30
Environment=GOMEMLIMIT=96MiB
ExecStart=/usr/local/bin/heimdrive
Restart=on-failure
RestartSec=3
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/heimdrive

MemoryHigh=64M
MemoryMax=128M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
